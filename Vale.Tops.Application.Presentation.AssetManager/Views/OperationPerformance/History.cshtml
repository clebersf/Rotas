@model Vale.Tops.Application.Presentation.AssetManager.Models.OperationPerformanceViewModel

@{
       ViewBag.Title = "Operação";
    ViewBag.SubTitle = "Historico Taxa Efetiva";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@using (Html.BeginForm("History", "OperationPerformance", FormMethod.Post, new { id = "frmClient" }))
{
    @Html.AntiForgeryToken()
    <div class="col-md-12">
        <div class="row">
            <div class="panel panel-body">
                <div class="bootstrap-admin-panel-content">

                    <div class="form-row">
                        <div class="form-group">
                            @Html.LabelFor(model => model.dhpi, htmlAttributes: new { @class = "control-label col-sm-1" })
                            <div class="col-sm-1">
                                @Html.EditorFor(model => model.dhpi, new { htmlAttributes = new { @class = "form-control" } })
                            </div>
                        </div>

                        <div class="form-group">
                            @Html.LabelFor(model => model.dhpf, htmlAttributes: new { @class = "control-label col-sm-1" })
                            <div class="col-sm-1">
                                @Html.EditorFor(model => model.dhpf, new { htmlAttributes = new { @class = "form-control" } })
                            </div>
                        </div>

                        <div class="form-group">
                            @Html.LabelFor(model => model.Origem, htmlAttributes: new { @class = "control-label col-md-1" })
                            <div class="col-md-1">
                                @Html.DropDownListFor(model => model.Origem, new SelectList(Model.Locations.OrderBy(e => e.Alias), "Alias", "Alias"), "--Selecione um registro--", new { style = "font-size:100%;", data_val = false })
                            </div>
                        </div>
                    </div>
                    <br />
                    <br />
                    <br />
                    <div class="form-row">
                        <div class="form-group">
                            <div class="col-md-1">
                                <button type="submit" class="btn btn-primary btn-sm" style="width:100px">Pesquisar</button>
                            </div>
                        </div>
                    </div>
                    <br />
                    <hr />
                    <div class="row">
                        | <i class="fa fa-info-circle"></i> @Html.DisplayFor(model => model.lines) linha(s) retornada(s). | @ViewBag.Message
                    </div>
                    <div id="dvScroll" style="overflow: scroll;overflow-x: scroll;">
                        <table class="table table-striped table-condensed table-bordered table-responsive-md panel panel-body" id="tTable">
                            <thead>
                                <tr>
                                    <th>
                                        @Html.DisplayNameFor(model => model.Id)
                                    </th>
                                    <th>
                                        @Html.DisplayNameFor(model => model.Inicio)
                                    </th>
                                    <th>
                                        @Html.DisplayNameFor(model => model.Termino)
                                    </th>
                                    <th>
                                        @Html.DisplayNameFor(model => model.Berco)
                                    </th>
                                    <th>
                                        @Html.DisplayNameFor(model => model.Destino)
                                    </th>
                                    <th>
                                        @Html.DisplayNameFor(model => model.Porao)
                                    </th>
                                    <th>
                                        @Html.DisplayNameFor(model => model.TotalDestino)
                                    </th>
                                    <th>
                                        @Html.DisplayNameFor(model => model.txEfetivaDestino)
                                    </th>
                                    <th>
                                        @Html.DisplayNameFor(model => model.Origem)
                                    </th>
                                    <th>
                                        @Html.DisplayNameFor(model => model.TotalOrigem)
                                    </th>
                                    <th>
                                        @Html.DisplayNameFor(model => model.txEfetivaOrigem)
                                    </th>
                                    <th>
                                        @Html.DisplayNameFor(model => model.QtdPeak)
                                    </th>
                                    <th>
                                        @Html.DisplayNameFor(model => model.TimePeak)
                                    </th>
                                    <th>
                                        @Html.DisplayNameFor(model => model.txPeak)
                                    </th>


                                    <th>
                                        @Html.DisplayNameFor(model => model.txL2)
                                    </th>
                                    <th>
                                        @Html.DisplayNameFor(model => model.txL3)
                                    </th>
                                    <th>
                                        @Html.DisplayNameFor(model => model.txL4)
                                    </th>
                                    <th>
                                        @Html.DisplayNameFor(model => model.txL5)
                                    </th>
                                    <th>
                                        @Html.DisplayNameFor(model => model.txL6)
                                    </th>

                                    <th>
                                        @Html.DisplayNameFor(model => model.Operator)
                                    </th>

</thead>
                            <tbody>
                                @{int i = 0;}
                                @foreach (var item in Model.EffectiveRates)
                                {
                                <tr>
                                    <td style="width:10px">
                                        @Html.DisplayFor(modelItem => i)
                                    </td>

                                    <td style="width:5px">
                                        @Html.DisplayFor(modelItem => item.Inicio)
                                    </td>
                                    <td style="width:5px">
                                        @Html.DisplayFor(modelItem => item.Termino)
                                    </td>
                                    <td style="width:10px">
                                        @Html.DisplayFor(modelItem => item.Berco)
                                    </td>
                                    <td style="width:10px">
                                        @Html.DisplayFor(modelItem => item.Destino)
                                    </td>
                                    <td style="width:10px">
                                        @Html.DisplayFor(modelItem => item.Porao)
                                    </td>
                                    <td style="width:10px">
                                        @Html.DisplayFor(modelItem => item.TotalDestino)
                                    </td>
                                    <td style="width:10px">
                                        @Html.DisplayFor(modelItem => item.txEfetivaDestino)
                                    </td>
                                    <td style="width:10px">
                                        @Html.DisplayFor(modelItem => item.Origem)
                                    </td>
                                    <td style="width:10px">
                                        @Html.DisplayFor(modelItem => item.TotalOrigem)
                                    </td>
                                    <td style="width:10px">
                                        @Html.DisplayFor(modelItem => item.txEfetivaOrigem)
                                    </td>
                                    <td style="width:10px">
                                        @Html.DisplayFor(modelItem => item.QtdPeak)
                                    </td>
                                    <td style="width:10px">
                                        @Html.DisplayFor(modelItem => item.TimePeak)
                                    </td>
                                    <td style="width:10px">
                                        @Html.DisplayFor(modelItem => item.txPeak)
                                    </td>

                                    <td style="width:10px">
                                        @Html.DisplayFor(modelItem => item.txL2)
                                    </td>
                                    <td style="width:10px">
                                        @Html.DisplayFor(modelItem => item.txL3)
                                    </td>
                                    <td style="width:10px">
                                        @Html.DisplayFor(modelItem => item.txL4)
                                    </td>
                                    <td style="width:10px">
                                        @Html.DisplayFor(modelItem => item.txL5)
                                    </td>
                                    <td style="width:10px">
                                        @Html.DisplayFor(modelItem => item.txL6)
                                    </td>

                                    <td style="width:10px">
                                        @Html.DisplayFor(modelItem => item.Operator)
                                    </td>
                                </tr>
                                    i++;
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@{ Html.EndForm(); }
<!-- Modal -->



<script type="text/javascript">

    window.onload = function () {
        $(document).ready(function () {
           // $('#tTable').fixedHeaderTable({ footer: false, cloneHeadToFoot: false, fixedColumn: false });

    $("#divCarregando").show();
    $(window).load(function () {
        // Quando a página estiver totalmente carregada, remove o id
        $('#divCarregando').fadeOut('slow');
    });
});
        $(function () {
            $.validator.methods.date = function (value, element) {
                return this.optional(element) || moment(value, "DD/MM/YYYY", true).isValid();
            }
        });
        $.validator.unobtrusive.parse("#frmClient form");

        $('input[type=datetime]').datepicker({
            dateFormat: 'dd/mm/yy',
            dayNames: ['Domingo', 'Segunda', 'Terça', 'Quarta', 'Quinta', 'Sexta', 'Sábado'],
            dayNamesMin: ['D', 'S', 'T', 'Q', 'Q', 'S', 'S', 'D'],
            dayNamesShort: ['Dom', 'Seg', 'Ter', 'Qua', 'Qui', 'Sex', 'Sáb', 'Dom'],
            monthNames: ['Janeiro', 'Fevereiro', 'Março', 'Abril', 'Maio', 'Junho', 'Julho', 'Agosto', 'Setembro', 'Outubro', 'Novembro', 'Dezembro'],
            monthNamesShort: ['Jan', 'Fev', 'Mar', 'Abr', 'Mai', 'Jun', 'Jul', 'Ago', 'Set', 'Out', 'Nov', 'Dez'],
            nextText: 'Proximo',
            prevText: 'Anterior',
            showOn: "button"
        }).css("display", "inline-block")//.datepicker("setDate", new Date())
            .next("button").button({
                icons: { primary: "ui-icon-calendar" },
                label: "",
                text: false
            });


        var oTable = $("#tTable").DataTable({
            "dom": 'Bfrtip',
            "buttons": [
                'copy', 'excel'
            ],
            "language": {
                "lengthMenu": "Exibe _MENU_ Registros por página",
                "search": "Procurar",
                "paginate": { "previous": "Retorna", "next": "Avança" },
                "zeroRecords": "Nada foi encontrado",
                "info": "Exibindo página _PAGE_ de _PAGES_",
                "infoEmpty": "Sem registros",
                "infoFiltered": "(filtrado de _MAX_ regitros totais)"
            },
            "order": [[0, "asc"]],
            "processing": true, // mostrar a progress bar
            //"serverSide": true, // processamento no servidor
            "filter": true,     // habilita o filtro(search box)
            "lengthMenu": [[10, 25, 50, -1], [10, 25, 50, "Todos"]],
            "pageLength": -1,    // define o tamanho da página
        });
    }


</script>

