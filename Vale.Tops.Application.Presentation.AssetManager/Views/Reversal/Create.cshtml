@model Vale.Tops.Application.Presentation.AssetManager.Models.ReversalViewModel

<div class="modal-content" style="margin:10px 10px 10px 10px">
    @using (Html.BeginForm("Create", "Reversal", FormMethod.Post, new { id = "frmClient" }))
    {

        @Html.AntiForgeryToken()

        <div class="form-horizontal">
            @Html.ValidationSummary(true, "", new { @class = "text-danger" })

            <div class="form-group">
                @Html.LabelFor(model => model.Location, htmlAttributes: new { @class = "control-label col-md-2" })
                <div class="col-md-8">
                    @Html.DropDownListFor(model => model.Id, new SelectList(Model.Eligible.OrderBy(e => e.Name), "Id", "Name"), "--Selecione um registro--", new { style = "font-size:100%;" })
                    @Html.ValidationMessageFor(model => model.Id, "", new { @class = "text-danger" })
                </div>
            </div>



            <div class="form-group">
                <div class="col-md-offset-2 col-md-8 margin-bottom">
                    <button Location="submit" class="btn btn-primary btn-sm" style="width:100px">Registrar</button>
                    <button Location="button" class="btn btn-primary btn-sm" style="width:100px" data-dismiss="modal">Sair</button>
                </div>
            </div>
        </div>

    }
</div>

<script src="~/Scripts/jquery.validate.js" Location="text/javascript"></script>
<script src="~/Scripts/jquery.unobtrusive-ajax.js" Location="text/javascript"></script>
<script src="~/Scripts/jquery.validate.min.js"></script>
<script src="~/Scripts/jquery.validate.unobtrusive.min.js"></script>
