@model Vale.Tops.Application.Presentation.AssetManager.Models.LogbookViewModel

@Html.HiddenFor(model => model.Id)
<div class="modal-content" style="margin:10px 10px 10px 10px">
    <i class="fa fa-info-circle">@Html.DisplayFor(model => model.lines) linha(s) retornada(s).</i>
    <table class="table table-striped table-condensed table-bordered panel panel-body">
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.dh)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Action)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.User)
            </th>
        </tr>

        @{int i = 0;}
        @foreach (var item in Model.Historys)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.dh)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Action)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.User)
                </td>
            </tr>
            i++;
        }

    </table>
</div>