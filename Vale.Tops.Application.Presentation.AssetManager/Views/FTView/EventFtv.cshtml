@model Vale.Tops.Application.Presentation.AssetManager.Models.EventFtvViewModel

@{
    ViewBag.Title = "Diagnosticos de Supervisório";
    ViewBag.SubTitle = "Comandos do Supervisório";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@using (Html.BeginForm("EventFtv", "FTView", FormMethod.Post, new { id = "frmClient" }))
{
    @Html.AntiForgeryToken()
    <div class="col-md-12">
        <div class="row">
            <div class="panel panel-body">
                <div class="bootstrap-admin-panel-content">

                    <div class="form-row">
                        <div class="form-group">
                            @Html.LabelFor(model => model.dhpi, htmlAttributes: new { @class = "control-label col-sm-2" })
                            <div class="col-sm-2">
                                @Html.EditorFor(model => model.dhpi, new { htmlAttributes = new { @class = "form-control date-time-picker", onkeydown = "return false", onpaste = "return false" } })
                            </div>
                        </div>
                        <div class="form-group">
                            @Html.LabelFor(model => model.dhpf, htmlAttributes: new { @class = "control-label col-sm-2" })
                            <div class="col-sm-2">
                                @Html.EditorFor(model => model.dhpf, new { htmlAttributes = new { @class = "form-control date-time-picker", onkeydown = "return false", onpaste = "return false" } })
                            </div>
                        </div>

                        <div class="form-group">
                            @Html.LabelFor(model => model.Filter, htmlAttributes: new { @class = "control-label col-sm-2" })
                            <div class="col-sm-2">
                                @Html.EditorFor(model => model.Filter, new { htmlAttributes = new { @class = "form-control" } })
                            </div>
                        </div>
                    </div>
                    <br />
                    <br />
                    <br />
                    <div class="form-row">
                        <div class="form-group">
                            <div class="col-md-1">
                                <button type="submit" class="btn btn-primary btn-sm" style="width:100px">Pesquisar</button>
                            </div>
                        </div>
                    </div>
                    <br />
                    <hr />
                    <div class="row">
                        <i class="fa fa-info-circle"></i> @Html.DisplayFor(model => model.lines) linha(s) retornada(s). | @ViewBag.Message
                    </div>
                    <div id="dvScroll" style="overflow: scroll;overflow-x: scroll;">
                        <table class="table table-striped table-condensed table-responsive-md table-bordered panel panel-body" id="tTable">
                            <thead>
                                <tr>
                                    <th>
                                        @Html.DisplayNameFor(model => model.TimeStmp)
                                    </th>
                                    <th>
                                        @Html.DisplayNameFor(model => model.MessageText)
                                    </th>
                                    <th>
                                        @Html.DisplayNameFor(model => model.Location)
                                    </th>
                                    <th>
                                        @Html.DisplayNameFor(model => model.UserID)
                                    </th>
                                    <th>
                                        @Html.DisplayNameFor(model => model.UserFullName)
                                    </th>
                                    <th>
                                        @Html.DisplayNameFor(model => model.Provider)
                                    </th>
                                </tr>
                            </thead>
                            <tbody>
                                @{int i = 0;}
                                @foreach (var item in Model.Events)
                                {

                                    <tr>
                                        <td>
                                            @Html.DisplayFor(modelItem => item.TimeStmp)
                                        </td>
                                        <td>
                                            @Html.DisplayFor(modelItem => item.MessageText)
                                        </td>
                                        <td>
                                            @Html.DisplayFor(modelItem => item.Location)
                                        </td>
                                        <td>
                                            @Html.DisplayFor(modelItem => item.UserID)
                                        </td>
                                        <td>
                                            @Html.DisplayFor(modelItem => item.UserFullName)
                                        </td>
                                        <td>
                                            @Html.DisplayFor(modelItem => item.Provider)
                                        </td>
                                    </tr>
                                    i++;
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<div class="modal fade" id="ModalSelected" tabindex="-1" style="margin:5px 5px 5px 5px" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLabel"><label for="a" id="txtTitleSelected"></label></h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <label for="a" id="txtBodySelected"></label>
            </div>
            <div class="modal-footer">
                <div class="margin-bottom">
                    <button type="submit" class="btn btn-primary btn-sm" style="width:100px; ">Sim</button>
                    <button type="button" class="btn btn-primary btn-sm" style="width:100px" data-dismiss="modal">Não</button>
                </div>
            </div>
        </div>
    </div>
</div>

@{ Html.EndForm(); }
<!-- Modal -->


<div class="modal" id="myModal" style="margin:5px 5px 5px 5px" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><label for="a" id="txtTitlePartial"></label></h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body" id="myModalBodyDiv">

            </div>
        </div>
    </div>
</div>



<script type="text/javascript">



    window.onload = function () {
        $(function () {
            $.validator.methods.date = function (value, element) {
                return this.optional(element) || moment(value, "DD/MM/YYYY HH:mm:ss", true).isValid();
            }
        });
        $.validator.unobtrusive.parse("#frmClient form");
        $(document).ready(function () {

            $(function () {
                $(".date-time-picker").datetimepicker({
                    timeFormat: 'HH:mm:ss',
                    dateFormat: 'dd/mm/yy'
                });
            });

            $("#divCarregando").show();
            $(window).load(function () {
                // Quando a página estiver totalmente carregada, remove o id
                $('#divCarregando').fadeOut('slow');
            });
        });

        var oTable = $("#tTable").DataTable({
            "dom": 'Bfrtip',
            "buttons": [
                'copy', 'excel'
            ],
            "language": {
                "lengthMenu": "Exibe _MENU_ Registros por página",
                "search": "Procurar",
                "paginate": { "previous": "Retorna", "next": "Avança" },
                "zeroRecords": "Nada foi encontrado",
                "info": "Exibindo página _PAGE_ de _PAGES_",
                "infoEmpty": "Sem registros",
                "infoFiltered": "(filtrado de _MAX_ regitros totais)"
            },
            "order": [[0, "desc"]],
            "processing": true, // mostrar a progress bar
            //"serverSide": true, // processamento no servidor
            "filter": true,     // habilita o filtro(search box)
            "lengthMenu": [[10, 25, 50, -1], [10, 25, 50, "Todos"]],
            "pageLength": -1,    // define o tamanho da página
        });
    }



</script>

