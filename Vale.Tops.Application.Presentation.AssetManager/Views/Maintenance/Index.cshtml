@model Vale.Tops.Application.Presentation.AssetManager.Models.MaintenanceViewModel
@{
    ViewBag.Title = "Manutenção";
    ViewBag.SubTitle = "Gestão de Manutenções";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="col-md-12">
    <div class="row">
        <div class="panel panel-body">
            <div class="bootstrap-admin-panel-content">
                <div class="row">
                    <a href="#" class="btn btn-link" onclick="jqFunctionPartialViewCreate('','Novo Registro' )">Novo Registro <i class="glyphicon glyphicon-new-window"></i> </a> |
                    <a class="btn btn-link" data-toggle="modal" data-target="#ModalSelected" onclick="jqFunctionSelected('Apagar Selecionados', 'Você tem certeza que deseja apagar os registros?' )">Apagar Selecionados <i class="glyphicon glyphicon-remove-sign"></i></a> |
                    <i class="fa fa-info-circle"></i> @Html.DisplayFor(model => model.lines) linha(s) retornada(s). | @ViewBag.Message
                </div>
                @{ Html.BeginForm("Index", "Maintenance", FormMethod.Post, new { name = "tableForm" }); }
                <table class="table table-striped table-condensed table-bordered panel panel-body">
                    <tr>
                        @*<th>
                            @Html.DisplayNameFor(model => model.Location)
                        </th>*@
                        <th>
                            @Html.DisplayNameFor(model => model.dhi_prev)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.dhf_prev)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.dhi_real)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.dhf_real)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.Completed)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.Description)
                        </th>
                        <th>
                            Apagar
                        </th>
                        <th style="color:white">.........................................</th>
                    </tr>

                    @{int i = 0;}
                    @foreach (var item in Model.Maintenances)
                    {
                        <tr>
                            @*<td>
                                @Html.DisplayFor(modelItem => Model.NameLocations[i])
                            </td>*@
                            <td>
                                @Html.DisplayFor(modelItem => item.dhi_prev)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.dhf_prev)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.dhi_real)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.dhf_real)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Completed)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Description)
                            </td>
                            <td>
                                @Html.CheckBoxFor(modelItem => Model.Selecteds[i].isSelected, new { htmlAttributes = new { @class = "form-control" } })
                                @Html.HiddenFor(model => Model.Selecteds[i].id)
                            </td>
                            <td>
                                <a href="#" class="btn btn-link" onclick="jqFunctionPartialViewEdit('@item.Id','Editar Registro' )">Editar<i class="glyphicon glyphicon-edit"></i> </a> |
                                <a class="btn btn-link" data-toggle="modal" data-target="#ModalSelected" onclick="jqFunctionSelected('Apagar Registro', 'Você tem certeza que deseja apagar o registro?', '@item.Id' )">Apagar<i class="glyphicon glyphicon-remove"></i></a>|
                                <a href="#" class="btn btn-link" onclick="jqFunctionPartialViewImport('@item.Id','Importar Planilha' )">Importar<i class="glyphicon glyphicon-new-window"></i> </a> |
                                @Html.HiddenFor(model => model.Id, new { @id = "IdScript" })
                                @Html.ActionLink("Serviços", "Index", "Job", new { id = item.Id },new {@class = "btn btn-link glyphicon glyphicon-edit"})
                             </td>
                        </tr>
                        i++;
                    }
                </table>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="ModalSelected" tabindex="-1" style="margin:5px 5px 5px 5px" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLabel"><label for="a" id="txtTitleSelected"></label></h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <label for="a" id="txtBodySelected"></label>
            </div>
            <div class="modal-footer">
                <div class="margin-bottom">
                    <button type="submit" class="btn btn-primary btn-sm" style="width:100px; ">Sim</button>
                    <button type="button" class="btn btn-primary btn-sm" style="width:100px" data-dismiss="modal">Não</button>
                </div>
            </div>
        </div>
    </div>
</div>

@{ Html.EndForm(); }
<!-- Modal -->


<div class="modal" id="myModal" style="margin:5px 5px 5px 5px" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><label for="a" id="txtTitlePartial"></label></h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body" id="myModalBodyDiv">

            </div>
        </div>
    </div>
</div>



<script type="text/javascript">

    var jqFunctionPartialViewEdit = function (Id, str_titulo) {
        $('#txtTitlePartial').html(str_titulo);
        $("#myModalBodyDiv").load("@Url.Action("Edit", "Maintenance")" + '/' + Id, function () {
            $("#myModal").modal("show");

        })

    }

    var jqFunctionPartialViewCopy = function (Id, str_titulo) {
        $('#txtTitlePartial').html(str_titulo);
        $("#myModalBodyDiv").load("@Url.Action("Copy", "Maintenance")" + '/' + Id, function () {
            $("#myModal").modal("show");

        })

    }

    var jqFunctionPartialViewCreate = function (Id, str_titulo) {
        $('#txtTitlePartial').html(str_titulo);
        $("#myModalBodyDiv").load("@Url.Action("Create", "Maintenance")" + '/' + Id, function () {
            $("#myModal").modal("show");

        })

    }

    var jqFunctionPartialViewImport = function (Id, str_titulo) {
        $('#txtTitlePartial').html(str_titulo);
        $("#myModalBodyDiv").load("@Url.Action("Import", "Maintenance")" + '/' + Id, function () {
            $("#myModal").modal("show");

        })

    }

    var jqFunctionSelected = function (str_titulo, str_body, Id) {
        $('#txtTitleSelected').html(str_titulo);
        $('#txtBodySelected').html(str_body);
        $('#myModalSelected').on('shown.bs.modal', function () {

        })
        $('#IdScript').val(Id);
    }

</script>
