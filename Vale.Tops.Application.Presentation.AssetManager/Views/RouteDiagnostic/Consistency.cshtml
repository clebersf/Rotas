@model Vale.Tops.Application.Presentation.AssetManager.Models.RouteDiagnosticViewModel

@{
    ViewBag.Title = " Diagnostico Técnico";
    ViewBag.SubTitle = "Lista de consistência";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@{ Html.BeginForm("Index", "RouteDiagnostic", FormMethod.Post, new { name = "tableForm" }); }
<div class="col-md-12">
    <div class="row">
        <div class="panel panel-body">

            <hr />
            <div class="bootstrap-admin-panel-content">
                <div class="row">
                    <i class="fa fa-info-circle"></i> @Html.DisplayFor(model => model.lines) linha(s) retornada(s). | @ViewBag.Message
                </div>

                <table class="table" id="tTable">
                    <thead>
                        <tr>
                            <th>
                                @Html.DisplayNameFor(model => model.TagId)
                            </th>
                            <th>
                                @Html.DisplayNameFor(model => model.Type)
                            </th>
                            <th>
                                @Html.DisplayNameFor(model => model.Id)
                            </th>
                            <th>
                                @Html.DisplayNameFor(model => model.Route)
                            </th>
                            <th>
                                @Html.DisplayNameFor(model => model.AssetCurrent)
                            </th>
                            <th>
                                @Html.DisplayNameFor(model => model.AssetNext)
                            </th>
                            <th>
                                @Html.DisplayNameFor(model => model.Veredict)
                            </th>
                            <th>
                                @Html.DisplayNameFor(model => model.DescriptionMode)
                            </th>
                            <th>
                                @Html.DisplayNameFor(model => model.TagName)
                            </th>
                            <th>
                                @Html.DisplayNameFor(model => model.Current)
                            </th>
                            <th>
                                @Html.DisplayNameFor(model => model.Desired)
                            </th>
                            <th style="color:white">.........................................</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{int i = 0;}
                        @foreach (var item in Model.ctrippers)
                        {
                            <tr>
                                <td>
                                    @Html.DisplayFor(modelItem => item.TagId)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.Type)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.Id)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.Route)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.AssetCurrent)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.AssetNext)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.Veredict)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.DescriptionMode)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.TagName)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.Current)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.Desired)
                                </td>
                                <td>
                                    <a href="#" class="btn btn-link" onclick="jqFunctionPartialViewEdit('@item.TagId','Simular valores' )">Simular valores<i class="glyphicon glyphicon-edit"></i> </a>
                                    @Html.HiddenFor(model => model.TagId, new { @id = "IdScript" })
                                </td>
                            </tr>
                            i++;
                        }
                    </tbody>

                </table>
            </div>
        </div>
    </div>
</div>


<div class="modal fade" id="ModalSelected" tabindex="-1" style="margin:5px 5px 5px 5px" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLabel"><label for="a" id="txtTitleSelected"></label></h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <label for="a" id="txtBodySelected"></label>
            </div>
            <div class="modal-footer">
                <div class="margin-bottom">
                    <button type="submit" class="btn btn-primary btn-sm" style="width:100px; ">Sim</button>
                    <button type="button" class="btn btn-primary btn-sm" style="width:100px" data-dismiss="modal">Não</button>
                </div>
            </div>
        </div>
    </div>
</div>


@{ Html.EndForm(); }
<!-- Modal -->


<div class="modal" id="myModal" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><label for="a" id="txtTitlePartial"></label></h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body" id="myModalBodyDiv">

            </div>
            @*<div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Sair</button>
                </div>*@
        </div>
    </div>
</div>



<script type="text/javascript">
     window.onload = function () {


        var oTable = $("#tTable").DataTable({
            "dom": 'Bfrtip',
            "buttons": [
                'copy', 'excel'
            ],
            "language": {
                "lengthMenu": "Exibe _MENU_ Registros por página",
                "search": "Procurar",
                "paginate": { "previous": "Retorna", "next": "Avança" },
                "zeroRecords": "Nada foi encontrado",
                "info": "Exibindo página _PAGE_ de _PAGES_",
                "infoEmpty": "Sem registros",
                "infoFiltered": "(filtrado de _MAX_ regitros totais)"
            },
            "order": [[1, "desc"]],
            "processing": true, // mostrar a progress bar
            //"serverSide": true, // processamento no servidor
            "filter": true,     // habilita o filtro(search box)
            "lengthMenu": [[10, 25, 50, -1], [10, 25, 50, "Todos"]],
            "pageLength": 100,    // define o tamanho da página
        });
    }

    var jqFunctionPartialViewEdit = function (Id, str_titulo) {
        $('#txtTitlePartial').html(str_titulo);
        $("#myModalBodyDiv").load("@Url.Action("Simulation", "RouteDiagnostic")" + '/' + Id, function () {
            $("#myModal").modal("show");

        })

    }


</script>

