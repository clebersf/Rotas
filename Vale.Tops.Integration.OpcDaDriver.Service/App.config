<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
	  <add key="Service.Name" value="PLC176" />
	  <!-- Descrição visível no Services.msc -->
	  <add key="Service.Description" value="Um teste do driver de plc" />
	  <add key="PLC.Id" value="176" />

    <add key="Timers.FlushMeasuresMs" value="300" />
    <add key="Timers.PollWritesMs" value="500" />
    <add key="Writes.Enabled" value="true" />

    <add key="Timers.ReconnectInitialMs" value="2000" />
    <add key="Timers.ReconnectMaxMs" value="60000" />

    <add key="ItemId.Prefix" value="" />
    <add key="ItemId.Separator" value="." />
    <add key="ItemId.Suffix" value="" />
    <add key="ItemId.UseBrackets" value="false" />

    <!-- === LOGS === -->
    <!-- Pasta onde os logs de arquivo serão gravados. Se vazio, usa %PROGRAMDATA%\OPCDAService\logs -->
    <add key="Logs.Path" value="C:\Temp\OpcDaLogs" />
    <!-- Grava também no Event Viewer (Application) -->
    <add key="Logs.WriteEventViewer" value="true" />

    <!-- === HEALTH === -->
    <add key="Health.Enabled" value="true" />
    <add key="Health.LogIntervalMs" value="30000" />
  </appSettings>

  <connectionStrings>
    <add name="Connection_AssetManager"
         connectionString="Data Source=IEAU-ES-NBA03\SQLEXPRESS;Initial Catalog=Route;User ID=sa;Password=Sql@sapo;MultipleActiveResultSets=True;TrustServerCertificate=True"
         providerName="System.Data.SqlClient" />
    <add name="WriteReadContext"
         connectionString="Data Source=IEAU-ES-NBA03\SQLEXPRESS;Initial Catalog=Route;User ID=sa;Password=Sql@sapo;MultipleActiveResultSets=True;TrustServerCertificate=True"
         providerName="System.Data.SqlClient" />
  </connectionStrings>

  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2"/>
  </startup>
</configuration>
